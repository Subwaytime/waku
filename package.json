{
	"name": "@subwaytime/waku",
	"version": "1.0.4",
	"private": false,
	"description": "Vue 3 Component DOM Mounting",
	"keywords": [
		"vite",
		"vue",
		"vue3",
		"dom",
		"mount",
		"components"
	],
	"homepage": "https://github.com/subwaytime/waku#readme",
	"bugs": "https://github.com/subwaytime/waku/issues",
	"repository": {
		"type": "git",
		"url": "https://github.com/subwaytime/waku"
	},
	"license": "MIT",
	"author": "Subwaytime <leon.l@nophase.de>",
	"type": "module",
	"exports": {
		".": {
			"import": "./dist/index.js",
			"types": "./dist/index.d.ts"
		}
	},
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"files": [
		"./dist"
	],
	"scripts": {
		"dev": "bunx --bun tsdown --watch",
		"bundle": "bunx --bun tsdown",
		"clean": "bun run format && bun run lint:fix",
		"format": "biome format --write .",
		"lint": "biome ci",
		"lint:fix": "biome lint --write .",
		"prepublishOnly": "bun run bundle",
		"release": "bunx git-ensure -a && bunx bumpp --commit --tag --push && bun publish --access public"
	},
	"dependencies": {
		"defu": "6.1.7",
		"mitt": "3.0.1",
		"nanoid": "6.0.2",
		"tsdown": "0.23.0",
		"vue": "3.5.43",
		"vue-tsc": "3.3.12"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.15",
		"@socketsecurity/bun-security-scanner": "1.1.3",
		"@types/bun": "1.4.2",
		"type-fest": "5.10.0",
		"typescript": "7.0.2",
		"unplugin-vue": "8.0.0",
		"vite": "8.3.3",
		"vue-component-type-helpers": "3.3.12"
	},
	"peerDependencies": {
		"vue": "^3.5.17"
	},
	"engines": {
		"bun": ">=1.2.10"
	}
}
